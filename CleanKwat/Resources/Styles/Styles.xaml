<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <x:Double x:Key="RadiusSmall">8</x:Double><x:Double x:Key="RadiusMedium">12</x:Double><x:Double x:Key="RadiusLarge">16</x:Double><x:Double x:Key="RadiusXLarge">24</x:Double>
  <x:Double x:Key="Space1">4</x:Double><x:Double x:Key="Space2">8</x:Double><x:Double x:Key="Space3">12</x:Double><x:Double x:Key="Space4">16</x:Double><x:Double x:Key="Space5">24</x:Double><x:Double x:Key="Space6">32</x:Double>

  <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Background}" /><Setter Property="Shell.NavBarIsVisible" Value="False" /></Style>
  <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="FontFamily" Value="Inter" /></Style>
  <Style x:Key="H1" TargetType="Label"><Setter Property="FontSize" Value="28"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="LineHeight" Value="1.22"/></Style>
  <Style x:Key="H2" TargetType="Label"><Setter Property="FontSize" Value="22"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="LineHeight" Value="1.25"/></Style>
  <Style x:Key="H3" TargetType="Label"><Setter Property="FontSize" Value="18"/><Setter Property="FontAttributes" Value="Bold"/></Style>
  <Style x:Key="Body" TargetType="Label"><Setter Property="FontSize" Value="16"/><Setter Property="LineHeight" Value="1.35"/></Style>
  <Style x:Key="BodySmall" TargetType="Label"><Setter Property="FontSize" Value="14"/><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/><Setter Property="LineHeight" Value="1.3"/></Style>
  <Style x:Key="Caption" TargetType="Label"><Setter Property="FontSize" Value="12"/><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/></Style>
  <Style x:Key="Eyebrow" TargetType="Label"><Setter Property="FontSize" Value="11"/><Setter Property="CharacterSpacing" Value="1.2"/><Setter Property="TextTransform" Value="Uppercase"/><Setter Property="TextColor" Value="{StaticResource TextSecondary}"/></Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="FontSize" Value="15"/><Setter Property="HeightRequest" Value="52"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20,0"/>
    <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="#145A3A"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="BackgroundColor" Value="#475569"/><Setter Property="TextColor" Value="#94A3B8"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#26364D"/><Setter Property="BorderColor" Value="{StaticResource Border}"/><Setter Property="BorderWidth" Value="1"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/><Setter Property="FontFamily" Value="Inter"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="FontSize" Value="15"/><Setter Property="HeightRequest" Value="48"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="DangerButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Error}"/><Setter Property="TextColor" Value="White"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="HeightRequest" Value="50"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="TextButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="TextColor" Value="{StaticResource PrimaryBright}"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="Padding" Value="4"/></Style>

  <Style x:Key="EntryStyle" TargetType="Entry"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/><Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="15"/><Setter Property="HeightRequest" Value="48"/><Setter Property="ClearButtonVisibility" Value="WhileEditing"/></Style>
  <Style x:Key="EditorStyle" TargetType="Editor"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="TextColor" Value="{StaticResource TextPrimary}"/><Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="15"/></Style>
  <Style x:Key="FieldBorder" TargetType="Border"><Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}"/><Setter Property="Stroke" Value="{StaticResource Border}"/><Setter Property="StrokeThickness" Value="1"/><Setter Property="Padding" Value="12,0"/><Setter Property="StrokeShape" Value="RoundRectangle 12"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="#3A4C67"/><Setter Property="Stroke" Value="Transparent"/><Setter Property="Padding" Value="16"/><Setter Property="StrokeShape" Value="RoundRectangle 16"/></Style>
  <Style x:Key="CardOutline" TargetType="Border"><Setter Property="BackgroundColor" Value="#3A4C67"/><Setter Property="Stroke" Value="{StaticResource Primary}"/><Setter Property="StrokeThickness" Value="1.4"/><Setter Property="Padding" Value="16"/><Setter Property="StrokeShape" Value="RoundRectangle 16"/></Style>
  <Style x:Key="Pill" TargetType="Border"><Setter Property="Padding" Value="10,4"/><Setter Property="StrokeThickness" Value="0"/><Setter Property="StrokeShape" Value="RoundRectangle 999"/></Style>
  <Style x:Key="SectionDivider" TargetType="BoxView"><Setter Property="HeightRequest" Value="1"/><Setter Property="Color" Value="#334155"/></Style>
</ResourceDictionary>
