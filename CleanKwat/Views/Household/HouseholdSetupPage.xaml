<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Household.HouseholdSetupPage">
  <ScrollView><VerticalStackLayout Padding="28,22,28,30" Spacing="16">
    <controls:PageHeader Title="Votre ménage" Subtitle="Ces informations permettent de vous proposer le service adapté."/>
    <Label Text="⌂  Quartier sélectionné" Style="{StaticResource Caption}" TextColor="{StaticResource PrimaryBright}"/>
    <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding NeighborhoodLabel}" FontAttributes="Bold"/><Button Grid.Column="1" Text="Modifier" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8"/></Grid></Border>
    <Label Text="⌂  Taille du ménage" Style="{StaticResource Caption}" TextColor="{StaticResource PrimaryBright}"/>
    <HorizontalStackLayout Spacing="12"><Button Text="−" Style="{StaticResource SecondaryButton}" WidthRequest="56" Command="{Binding DecrementCommand}"/><Border Style="{StaticResource Card}" WidthRequest="100"><Label Text="{Binding HouseholdSize}" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/></Border><Button Text="+" Style="{StaticResource PrimaryButton}" WidthRequest="56" Command="{Binding IncrementCommand}"/></HorizontalStackLayout>
    <Label Text="⌂  Type d’habitation" Style="{StaticResource Caption}" TextColor="{StaticResource PrimaryBright}"/>
    <VerticalStackLayout Spacing="8"><Button Text="◉  Maison individuelle" Style="{StaticResource SecondaryButton}" BorderColor="{StaticResource Primary}" Command="{Binding SelectHousingCommand}" CommandParameter="Maison individuelle"/><Button Text="○  Appartement" Style="{StaticResource SecondaryButton}" Command="{Binding SelectHousingCommand}" CommandParameter="Appartement"/><Button Text="○  Concession" Style="{StaticResource SecondaryButton}" Command="{Binding SelectHousingCommand}" CommandParameter="Concession"/><Button Text="○  Autre" Style="{StaticResource SecondaryButton}" Command="{Binding SelectHousingCommand}" CommandParameter="Autre"/></VerticalStackLayout>
    <Button Text="Enregistrer le ménage" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
