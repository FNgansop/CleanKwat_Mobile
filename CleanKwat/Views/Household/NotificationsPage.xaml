<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Household.NotificationsPage">
  <Grid Padding="28,22,28,28" RowDefinitions="Auto,*" RowSpacing="14"><controls:PageHeader Grid.Row="0" Eyebrow="Espace Ménage" Title="Notifications" Subtitle="Alertes et messages de votre service."/><CollectionView Grid.Row="1" ItemsSource="{Binding Notifications}" EmptyView="Aucune notification"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid ColumnDefinitions="42,*"><Label Text="●" TextColor="{StaticResource PrimaryBright}" FontSize="20" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding Message}" Style="{StaticResource BodySmall}"/><Label Text="{Binding CreatedAt,StringFormat='{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource Caption}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
