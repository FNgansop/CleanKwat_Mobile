<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Household.CollectionDetailPage">
  <ScrollView><VerticalStackLayout Padding="28,22,28,30" Spacing="14">
    <controls:PageHeader Eyebrow="Espace Ménage" Title="Détail de la collecte" Subtitle="Les informations utiles pour préparer le passage."/>
    <Border Style="{StaticResource CardOutline}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="▣  Ordures ménagères" Style="{StaticResource H3}"/><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="#145A3A"><Label Text="À venir" FontSize="10"/></Border></Grid><Label Text="Date et horaire" Style="{StaticResource Caption}"/><Label Text="{Binding Collection.Date,StringFormat='Mercredi 15 mai 2024 · 06 h – 10 h'}"/><Label Text="Zone de passage" Style="{StaticResource Caption}"/><Label Text="{Binding Collection.Zone}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="Informations pratiques" Style="{StaticResource H3}"/><Grid ColumnDefinitions="34,*"><Label Text="♙" TextColor="{StaticResource TextSecondary}"/><VerticalStackLayout Grid.Column="1"><Label Text="Ramasseur" Style="{StaticResource Caption}"/><Label Text="{Binding Collection.CollectorName}" FontAttributes="Bold"/></VerticalStackLayout></Grid><Grid ColumnDefinitions="34,*"><Label Text="▣" TextColor="{StaticResource TextSecondary}"/><VerticalStackLayout Grid.Column="1"><Label Text="Équipe de collecte" Style="{StaticResource Caption}"/><Label Text="Collecte régulière" FontAttributes="Bold"/></VerticalStackLayout></Grid><Grid ColumnDefinitions="34,*"><Label Text="◷" TextColor="{StaticResource TextSecondary}"/><VerticalStackLayout Grid.Column="1"><Label Text="Consignes" Style="{StaticResource Caption}"/><Label Text="{Binding Collection.Instructions}"/></VerticalStackLayout></Grid></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="112,*"><Image Source="ck_03_clean_neighborhood.svg" WidthRequest="100" HeightRequest="80" Aspect="AspectFit"/><VerticalStackLayout Grid.Column="1"><Label Text="Un quartier propre commence par vous !" Style="{StaticResource H3}"/><Label Text="Respectez les horaires de sortie des déchets." Style="{StaticResource BodySmall}"/></VerticalStackLayout></Grid></Border>
    <Button Text="□  Retour au calendrier" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
