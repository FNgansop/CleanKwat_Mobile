<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Household.CalendarPage" x:Name="Page">
  <ScrollView><VerticalStackLayout Padding="28,22,28,30" Spacing="14">
    <controls:PageHeader Eyebrow="Espace Ménage" Title="Calendrier des collectes" Subtitle="Consultez les prochains passages dans votre quartier."/>
    <Label Text="◉  Ngousso · Yaoundé 1er" TextColor="{StaticResource PrimaryBright}" FontSize="14"/>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12">
      <Grid ColumnDefinitions="Auto,*,Auto"><Label Text="‹" FontSize="24"/><Label Grid.Column="1" Text="Mai 2024" FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="Center"/><Label Grid.Column="2" Text="›" FontSize="24"/></Grid>
      <Grid ColumnDefinitions="*,*,*,*,*,*,*"><Label Grid.Column="0" Text="L" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><Label Grid.Column="1" Text="M" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><Label Grid.Column="2" Text="M" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><Label Grid.Column="3" Text="J" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><Label Grid.Column="4" Text="V" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><Label Grid.Column="5" Text="S" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><Label Grid.Column="6" Text="D" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></Grid>
      <CollectionView ItemsSource="{Binding Days}" HeightRequest="245"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="3" VerticalItemSpacing="3"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="34" WidthRequest="34"><Label Text="{Binding DayText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="13"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter Property="TextColor" Value="White"/></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding HasCollection}" Value="True"><Setter Property="TextColor" Value="{StaticResource PrimaryBright}"/></DataTrigger></Label.Triggers></Label></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <HorizontalStackLayout Spacing="6"><BoxView WidthRequest="7" HeightRequest="7" Color="{StaticResource PrimaryBright}" CornerRadius="4"/><Label Text="Jour de collecte" Style="{StaticResource Caption}"/></HorizontalStackLayout>
    </VerticalStackLayout></Border>
    <Label Text="Collectes de ce mois" Style="{StaticResource H3}"/>
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Collections}" Spacing="10"><BindableLayout.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid ColumnDefinitions="46,*,Auto"><Label Text="□" TextColor="{StaticResource PrimaryBright}" FontSize="24" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="{Binding Date,StringFormat='{0:ddd. dd MMM yyyy}'}" FontAttributes="Bold"/><Label Text="{Binding TimeWindow,StringFormat='{0} · Déchets ménagers'}" Style="{StaticResource Caption}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" HorizontalOptions="End"><Border Style="{StaticResource Pill}" BackgroundColor="#145A3A"><Label Text="{Binding StatusDisplay}" FontSize="10"/></Border><Button Text="Voir" Style="{StaticResource TextButton}" FontSize="11" Command="{Binding Source={x:Reference Page},Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}"/></VerticalStackLayout></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
  </VerticalStackLayout></ScrollView>
</ContentPage>
