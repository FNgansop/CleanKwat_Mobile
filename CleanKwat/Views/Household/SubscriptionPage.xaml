<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Household.SubscriptionPage">
<ScrollView><VerticalStackLayout Padding="28,22" Spacing="16"><controls:PageHeader Eyebrow="Espace Ménage" Title="Mon abonnement" Subtitle="Consultez votre formule active."/><Border Style="{StaticResource CardOutline}"><VerticalStackLayout Spacing="10"><Image Source="ck_02_waste_truck.svg" HeightRequest="120"/><Label Text="{Binding Subscription.PlanName}" Style="{StaticResource H2}"/><Label Text="{Binding Subscription.MonthlyAmount,StringFormat='{0:N0} FCFA / mois'}" TextColor="{StaticResource PrimaryBright}" FontAttributes="Bold"/><Label Text="Collecte régulière · Service actif" Style="{StaticResource BodySmall}"/><Border Style="{StaticResource Pill}" BackgroundColor="{StaticResource Primary}" HorizontalOptions="Start"><Label Text="Actif"/></Border></VerticalStackLayout></Border><Button Text="Retour à l’accueil" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}"/></VerticalStackLayout></ScrollView>
</ContentPage>
