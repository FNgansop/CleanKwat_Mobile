<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Collector.CollectorDashboardPage">
  <ScrollView><VerticalStackLayout Padding="28,22,28,30" Spacing="14">
    <controls:PageHeader Eyebrow="Espace Ramasseur" Title="{Binding CollectorName,StringFormat='Bonjour {0} !'}" Subtitle="Ramasseur · Ngousso" ShowBack="False"/>
    <Grid ColumnDefinitions="*,Auto"><Label Text="Mer. 15 mai 2024" Style="{StaticResource H3}"/><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="#334155"><Label Text="Exemple" Style="{StaticResource Caption}"/></Border></Grid>
    <Label Text="Collectes de la tournée active" Style="{StaticResource Caption}"/>
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
      <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Planned}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Collectes prévues" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border>
      <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Completed}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Collectes effectuées" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border>
      <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding OpenReports}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Signalements ouverts" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border>
      <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding TodayTours}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Tournées ce jour" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border>
    </Grid>
    <Border Style="{StaticResource CardOutline}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="Tournée en cours" Style="{StaticResource H3}"/><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Primary}"><Label Text="En cours" FontSize="10"/></Border></Grid><Label Text="Quartier" Style="{StaticResource Caption}"/><Label Text="{Binding ActiveTour.Name}" FontAttributes="Bold"/><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding ActiveTour.CompletedCount,StringFormat='{0} collectes sur 12'}" Style="{StaticResource Caption}"/><Label Grid.Column="1" Text="{Binding ActiveTour.ProgressPercent,StringFormat='{0} %'}" TextColor="{StaticResource PrimaryBright}"/></Grid><ProgressBar Progress="{Binding ActiveTour.Progress}" ProgressColor="{StaticResource PrimaryBright}"/><Button Text="Voir la tournée" Style="{StaticResource PrimaryButton}" Command="{Binding OpenTourCommand}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="36,*"><Label Text="⟳" TextColor="{StaticResource PrimaryBright}" FontSize="24"/><VerticalStackLayout Grid.Column="1"><Label Text="Synchronisation" FontAttributes="Bold"/><Label Text="{Binding SyncLabel}" Style="{StaticResource Caption}"/></VerticalStackLayout></Grid></Border>
    <Button Text="Mes tournées" Style="{StaticResource SecondaryButton}" Command="{Binding OpenToursCommand}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
