<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Collector.TourDetailPage" x:Name="Page">
  <Grid Padding="28,22,28,28" RowDefinitions="Auto,Auto,*" RowSpacing="14"><controls:PageHeader Grid.Row="0" Eyebrow="Espace Ramasseur" Title="Tournée du jour" Subtitle="Liste des ménages à collecter."/><Border Grid.Row="1" Style="{StaticResource CardOutline}"><VerticalStackLayout Spacing="8"><Label Text="{Binding Tour.Name}" Style="{StaticResource H2}"/><Label Text="{Binding Tour.TimeWindow}" Style="{StaticResource Caption}"/><ProgressBar Progress="{Binding Tour.Progress}" ProgressColor="{StaticResource PrimaryBright}"/><Label Text="{Binding Tour.ProgressPercent,StringFormat='{0}% de la tournée effectuée'}" Style="{StaticResource Caption}"/></VerticalStackLayout></Border><CollectionView Grid.Row="2" ItemsSource="{Binding Stops}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid ColumnDefinitions="36,*,Auto"><Label Text="●" TextColor="{StaticResource PrimaryBright}"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding HouseholdName}" FontAttributes="Bold"/><Label Text="{Binding Address}" Style="{StaticResource Caption}"/></VerticalStackLayout><Button Grid.Column="2" Text="Confirmer" Style="{StaticResource TextButton}" Command="{Binding Source={x:Reference Page},Path=BindingContext.ConfirmCommand}" CommandParameter="{Binding .}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
