<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Collector.CollectorLoginPage">
  <ScrollView><VerticalStackLayout Padding="28,22,28,30" Spacing="14"><controls:PageHeader Eyebrow="Espace Ramasseur" Title="Connexion ramasseur" Subtitle="Accès sécurisé à votre espace et à vos tournées."/><Border Style="{StaticResource Card}" Padding="0"><Image Source="ck_02_waste_truck.svg" HeightRequest="135" Aspect="AspectFit"/></Border><Label Text="Téléphone ou e-mail" Style="{StaticResource Caption}"/><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Identifier}" Style="{StaticResource EntryStyle}"/></Border><Label Text="Mot de passe" Style="{StaticResource Caption}"/><Border Style="{StaticResource FieldBorder}"><Entry Text="{Binding Password}" IsPassword="True" Style="{StaticResource EntryStyle}"/></Border><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Error}" Style="{StaticResource Caption}" IsVisible="{Binding HasError}"/><Button Text="Se connecter" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}"/><Label Text="Votre compte est créé par l’administrateur de votre service de collecte." Style="{StaticResource BodySmall}"/><Button Text="☎  Contacter l’administrateur" Style="{StaticResource SecondaryButton}" Command="{Binding ContactAdminCommand}"/></VerticalStackLayout></ScrollView>
</ContentPage>
