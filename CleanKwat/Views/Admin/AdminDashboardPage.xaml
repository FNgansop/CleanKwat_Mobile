<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Admin.AdminDashboardPage">
  <ScrollView><VerticalStackLayout Padding="28,22,28,30" Spacing="14"><controls:PageHeader Eyebrow="Espace Admin" Title="Tableau de bord" Subtitle="Vue globale du système" ShowBack="False"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10"><Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Households}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Ménages" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border><Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Collectors}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Ramasseurs" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border><Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Collections}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Collectes" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="{Binding Reports}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Signalements" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border></Grid><Image Source="ck_21_analytics.svg" HeightRequest="180"/><Button Text="Gestion des quartiers" Style="{StaticResource PrimaryButton}" Command="{Binding OpenNeighborhoodsCommand}"/><Button Text="Suivi des collectes" Style="{StaticResource SecondaryButton}" Command="{Binding OpenCollectionsCommand}"/><Button Text="Gestion des ramasseurs" Style="{StaticResource SecondaryButton}" Command="{Binding OpenCollectorsCommand}"/></VerticalStackLayout></ScrollView>
</ContentPage>
