<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CleanKwat.Controls" x:Class="CleanKwat.Views.Admin.AdminCollectionsPage" x:Name="Page">
  <Grid Padding="28,22,28,28" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10"><controls:PageHeader Grid.Row="0" Eyebrow="Espace Admin" Title="Suivi des collectes" Subtitle="Consultez l’avancement et l’historique des tournées."/><Button Grid.Row="1" Text="＋  Nouvelle tournée" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/><Border Grid.Row="2" Style="{StaticResource FieldBorder}"><SearchBar Text="{Binding SearchText}" Placeholder="Quartier ou ramasseur..." BackgroundColor="Transparent" TextColor="White" PlaceholderColor="{StaticResource TextSecondary}"/></Border><Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10"><Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Période" Style="{StaticResource Caption}"/><Label Text="Mai 2024"/></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Quartier" Style="{StaticResource Caption}"/><Label Text="Tous"/></VerticalStackLayout></Border></Grid><Grid Grid.Row="4" ColumnDefinitions="*,*,*,*" ColumnSpacing="5"><Button Grid.Column="0" Text="Toutes" Style="{StaticResource PrimaryButton}" HeightRequest="36" FontSize="11" Command="{Binding FilterCommand}" CommandParameter="Toutes"/><Button Grid.Column="1" Text="En cours" Style="{StaticResource SecondaryButton}" HeightRequest="36" FontSize="11" Command="{Binding FilterCommand}" CommandParameter="En cours"/><Button Grid.Column="2" Text="Terminées" Style="{StaticResource SecondaryButton}" HeightRequest="36" FontSize="10" Command="{Binding FilterCommand}" CommandParameter="Terminées"/><Button Grid.Column="3" Text="Non réalisées" Style="{StaticResource SecondaryButton}" HeightRequest="36" FontSize="9" Command="{Binding FilterCommand}" CommandParameter="Non réalisées"/></Grid><CollectionView Grid.Row="5" ItemsSource="{Binding Tours}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid ColumnDefinitions="56,*,Auto"><Border BackgroundColor="#26364D" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="48" HeightRequest="48"><VerticalStackLayout Spacing="0" VerticalOptions="Center"><Label Text="{Binding Date, StringFormat='{0:dd}'}" HorizontalTextAlignment="Center" FontAttributes="Bold"/><Label Text="MAI" HorizontalTextAlignment="Center" FontSize="9"/></VerticalStackLayout></Border><VerticalStackLayout Grid.Column="1" Spacing="3"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding StatusDisplay}" Style="{StaticResource Caption}"/><ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource PrimaryBright}"/></VerticalStackLayout><Label Grid.Column="2" Text="{Binding ProgressPercent,StringFormat='{0}%'}" Style="{StaticResource Caption}" VerticalOptions="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>
