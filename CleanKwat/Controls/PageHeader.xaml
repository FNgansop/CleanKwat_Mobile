<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="CleanKwat.Controls.PageHeader" x:Name="Root">
  <VerticalStackLayout Spacing="6">
    <Grid ColumnDefinitions="44,*,58" HeightRequest="42">
      <Button Grid.Column="0" Text="‹" FontSize="30" BackgroundColor="Transparent" TextColor="White" Padding="0" IsVisible="{Binding ShowBack,Source={x:Reference Root}}" Clicked="OnBackClicked"/>
      <Label Grid.Column="1" Text="{Binding Eyebrow,Source={x:Reference Root}}" Style="{StaticResource Eyebrow}" VerticalOptions="Center" />
      <Border Grid.Column="2" BackgroundColor="#334155" Padding="10,5" StrokeThickness="0" StrokeShape="RoundRectangle 6" HorizontalOptions="End" VerticalOptions="Center"><Label Text="FR⌄" FontSize="12" HorizontalTextAlignment="Center"/></Border>
    </Grid>
    <Label Text="{Binding Title,Source={x:Reference Root}}" Style="{StaticResource H1}"/>
    <Label Text="{Binding Subtitle,Source={x:Reference Root}}" Style="{StaticResource BodySmall}" IsVisible="{Binding HasSubtitle,Source={x:Reference Root}}"/>
  </VerticalStackLayout>
</ContentView>
